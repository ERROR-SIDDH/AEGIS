# MongoDB Database Connection String
MONGODB_URI=mongodb://localhost:27017/aegis
# Or use MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/aegis?retryWrites=true&w=majority

# Genkit / Google Gemini AI Configuration (for AI-assisted question management)
GEMINI_API_KEY=your_gemini_api_key_here



# Default Administrative Credentials (used by seed-db script)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin_password_123
